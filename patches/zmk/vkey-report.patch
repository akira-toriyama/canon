 #define ZMK_HID_REPORT_ID_CONSUMER 0x02
 #define ZMK_HID_REPORT_ID_MOUSE 0x03
 
+// Vendor-defined "original key" (vkey) selector report. 0x20 is unused by the
+// standard reports above (0x01 keyboard/leds, 0x02 consumer, 0x03 mouse).
+#define ZMK_HID_REPORT_ID_VKEY 0x20
+
+// Split peripheral battery level, second report inside the same 0xFF31
+// collection. 0x21 is the next free report ID (0x01/0x02/0x03/0x20 taken).
+#define ZMK_HID_REPORT_ID_SPLIT_BATTERY 0x21
+
 #ifndef HID_ITEM_TAG_PUSH
