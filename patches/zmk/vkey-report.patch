+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#include <zephyr/kernel.h>
+
+#include <zephyr/logging/log.h>
+
+LOG_MODULE_DECLARE(zmk, CONFIG_ZMK_LOG_LEVEL);
+
+#include <zmk/endpoints.h>
+#include <zmk/event_manager.h>
+#include <zmk/events/battery_state_changed.h>
+#include <zmk/hid.h>
+
+// Mirrors a split peripheral's battery level to the USB host as vendor HID
+// report 0x21. Level 0 on peripheral disconnect is passed through unfiltered:
+// the host has to be able to tell "peripheral gone" from "0 %".
+//
+// Runs on the system work queue: both the discovery one-shot read and the GATT
+// notify only enqueue onto peripheral_event_msgq, and the raise happens in
+// peripheral_event_work_callback. That same work item also drains key position
+// events, so this callback must not block for long.
+static int peripheral_battery_hid_listener(const zmk_event_t *eh) {
+    const struct zmk_peripheral_battery_state_changed *ev =
+        as_zmk_peripheral_battery_state_changed(eh);
+    if (ev == NULL) {
+        return ZMK_EV_EVENT_BUBBLE;
+    }
+
+    // peripheral_slot_index_for_conn() can return -EINVAL into the uint8_t
+    // source field, so a disconnect on a connection that never held a slot
+    // arrives here as 234. Without this guard that reaches the host as a
+    // peripheral index.
+    if (ev->source >= CONFIG_ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS) {
+        LOG_WRN("Battery level for an out of range peripheral index: %u", ev->source);
+        return ZMK_EV_EVENT_BUBBLE;
+    }
+
+    LOG_DBG("Peripheral %u battery level %u", ev->source, ev->state_of_charge);
+
+    // Cache before sending, not after: a send the endpoint refuses still has to
+    // leave GET_REPORT(0x21) answering with the level we know. A half only
+    // notifies when its percentage changes and stops sampling 30 s after the
+    // last keypress, so a value dropped here is not resent for hours.
+    zmk_hid_split_battery_set(ev->source, ev->state_of_charge);
+
+    // Dropping is the intended outcome when the endpoint cannot take it:
+    // zmk_usb_hid_send_split_battery_report() refuses instead of queueing, so a
+    // battery level never evicts a keystroke from the pending ring and never
+    // remote-wakes a suspended host.
+    int err = zmk_endpoint_send_split_battery_report();
+    if (err) {
+        LOG_DBG("Dropped battery level for peripheral %u (%d)", ev->source, err);
+    }
+
+    return ZMK_EV_EVENT_BUBBLE;
+}
+
+ZMK_LISTENER(peripheral_battery_hid_listener, peripheral_battery_hid_listener);
+ZMK_SUBSCRIPTION(peripheral_battery_hid_listener, zmk_peripheral_battery_state_changed);
