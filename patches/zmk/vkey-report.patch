diff --git a/app/src/behaviors/behavior_vkey.c b/app/src/behaviors/behavior_vkey.c
new file mode 100644
index 00000000..7bd9dcd8
--- /dev/null
+++ b/app/src/behaviors/behavior_vkey.c
@@ -0,0 +1,97 @@
+/*
+ * Copyright (c) 2024 The ZMK Contributors
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#define DT_DRV_COMPAT zmk_behavior_vkey
+
+#include <zephyr/device.h>
+#include <drivers/behavior.h>
+#include <zephyr/logging/log.h>
+
+#include <zmk/hid.h>
+#include <zmk/endpoints.h>
+#include <zmk/behavior.h>
+#include <zmk/event_manager.h>
+#include <zmk/events/layer_state_changed.h>
+
+LOG_MODULE_DECLARE(zmk, CONFIG_ZMK_LOG_LEVEL);
+
+// Vendor-defined "original key": on press, set the 1-byte selector report to
+// the bound id and send it; on release, set 0 and send. Runs on the central
+// (no .locality -> BEHAVIOR_LOCALITY_CENTRAL), where the HID state and the USB
+// endpoint live, so no split event marshaling is needed.
+//
+// Modifier masking: the imprint thumb keys TU_LL/TU_LM hold LCtrl/LAlt while
+// their vkey layer is active (t_ll_ctrl / t_lm_alt), so those modifiers would
+// otherwise ride along with the vkey. The id is already unique, so no modifier
+// is wanted on it: on press we mask the thumb-owned modifiers still held
+// (explicit_mods & (MOD_LCTL|MOD_LALT) -- deliberately NOT every held modifier,
+// so a co-held Shift/Cmd/right-thumb mod is never captured or stranded) and
+// flush a keyboard report so the host sees Ctrl/Alt released. We do NOT restore
+// per key -- restoring on every release turned each vkey tap into a Ctrl down/up
+// "tap", which the OS reads as a repeated modifier tap (spurious macOS Dictation
+// "press Control twice", noisy Karabiner logs). The mask instead lives for the
+// whole hold and is cleared by the layer listener below when the thumb layer
+// turns off (its TU_MOD macro always deactivates &mo LAYER on release, so the
+// clear is deterministic). Net: at most one Ctrl/Alt down/up per hold, not one
+// per key; a hold with no vkey never masks, so plain TU_LL + mouse Ctrl+click
+// still works. Cost: a mouse Ctrl+click AFTER a vkey in the SAME hold sees no
+// Ctrl (rare "pattern C"). TU_RM/TU_RR and ist buttons own no Ctrl/Alt, so they
+// mask nothing.
+
+// Set while a vkey mask is active, so the layer listener clears exactly once
+// (and only when we actually masked) instead of on every unrelated layer-off.
+static bool vkey_masked = false;
+
+static int on_keymap_binding_pressed(struct zmk_behavior_binding *binding,
+                                     struct zmk_behavior_binding_event event) {
+    LOG_DBG("position %d vkey id %d", event.position, binding->param1);
+    zmk_mod_flags_t held = zmk_hid_get_explicit_mods() & (MOD_LCTL | MOD_LALT);
+    if (held) {
+        zmk_hid_masked_modifiers_set(held);
+        zmk_endpoint_send_report(HID_USAGE_KEY);
+        vkey_masked = true;
+    }
+    zmk_hid_vkey_set((uint8_t)(binding->param1 & 0xFF));
+    zmk_endpoint_send_vkey_report();
+    return ZMK_BEHAVIOR_OPAQUE;
+}
+
+static int on_keymap_binding_released(struct zmk_behavior_binding *binding,
+                                      struct zmk_behavior_binding_event event) {
+    LOG_DBG("position %d vkey release", event.position);
+    zmk_hid_vkey_clear();
+    zmk_endpoint_send_vkey_report();
+    return ZMK_BEHAVIOR_OPAQUE;
+}
+
+static const struct behavior_driver_api behavior_vkey_driver_api = {
+    .binding_pressed = on_keymap_binding_pressed,
+    .binding_released = on_keymap_binding_released,
+};
+
+// Clear the mask when a layer turns off while a vkey mask is active. The thumb
+// key that held Ctrl/Alt releases its &mo LAYER on release (TU_MOD macro), so
+// this fires deterministically for that hold; the vkey_masked guard makes it a
+// no-op for unrelated layer toggles, and the re-flush lets any still-held
+// modifier (the other thumb, or a co-held Ctrl) reappear on the keyboard report.
+static int vkey_layer_state_listener(const zmk_event_t *eh) {
+    const struct zmk_layer_state_changed *ev = as_zmk_layer_state_changed(eh);
+    if (ev && !ev->state && vkey_masked) {
+        zmk_hid_masked_modifiers_clear();
+        zmk_endpoint_send_report(HID_USAGE_KEY);
+        vkey_masked = false;
+    }
+    return ZMK_EV_EVENT_BUBBLE;
+}
+
+ZMK_LISTENER(vkey_mask, vkey_layer_state_listener);
+ZMK_SUBSCRIPTION(vkey_mask, zmk_layer_state_changed);
+
+#define VKEY_INST(n)                                                                               \
+    BEHAVIOR_DT_INST_DEFINE(n, NULL, NULL, NULL, NULL, POST_KERNEL,                                \
+                            CONFIG_KERNEL_INIT_PRIORITY_DEFAULT, &behavior_vkey_driver_api);
+
+DT_INST_FOREACH_STATUS_OKAY(VKEY_INST)
diff --git a/app/src/endpoints.c b/app/src/endpoints.c
index 17cdc5d7..474c01c0 100644
--- a/app/src/endpoints.c
+++ b/app/src/endpoints.c
@@ -261,6 +261,70 @@ int zmk_endpoint_send_report(uint16_t usage_page) {
     return -ENOTSUP;
 }
 
+int zmk_endpoint_send_vkey_report(void) {
+    switch (current_instance.transport) {
+    case ZMK_TRANSPORT_NONE:
+        return 0;
+
+    case ZMK_TRANSPORT_USB: {
+#if IS_ENABLED(CONFIG_ZMK_USB)
+        int err = zmk_usb_hid_send_vkey_report();
+        if (err) {
+            LOG_ERR("FAILED TO SEND VKEY OVER USB: %d", err);
+        }
+        return err;
+#else
+        LOG_ERR("USB endpoint is not supported");
+        return -ENOTSUP;
+#endif /* IS_ENABLED(CONFIG_ZMK_USB) */
+    }
+
+    case ZMK_TRANSPORT_BLE:
+        // vkey over BLE HOG is intentionally not implemented (descoped): no
+        // canon build target presents HOG to a PC, and there is no
+        // zmk_hog_send_vkey_report. See docs/vkey-roadmap.md.
+        LOG_WRN("vkey over BLE HOG not implemented (descoped)");
+        return -ENOTSUP;
+    }
+
+    LOG_ERR("Unhandled endpoint transport %d", current_instance.transport);
+    return -ENOTSUP;
+}
+
+#if IS_ENABLED(CONFIG_ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_HID)
+int zmk_endpoint_send_split_battery_report(void) {
+    switch (current_instance.transport) {
+    case ZMK_TRANSPORT_NONE:
+        return 0;
+
+    case ZMK_TRANSPORT_USB: {
+#if IS_ENABLED(CONFIG_ZMK_USB)
+        int err = zmk_usb_hid_send_split_battery_report();
+        if (err) {
+            // Refusing the send is routine, not an error: the level is dropped
+            // whenever the bus is suspended or reports are still queued.
+            LOG_DBG("Split battery report not sent over USB: %d", err);
+        }
+        return err;
+#else
+        LOG_ERR("USB endpoint is not supported");
+        return -ENOTSUP;
+#endif /* IS_ENABLED(CONFIG_ZMK_USB) */
+    }
+
+    case ZMK_TRANSPORT_BLE:
+        // Same descope as vkey: no canon target presents HOG to a PC and there
+        // is no zmk_hog_send_split_battery_report. LOG_DBG, not LOG_WRN: this
+        // fires on every battery notify while BLE is the active endpoint.
+        LOG_DBG("split battery over BLE HOG not implemented (descoped)");
+        return -ENOTSUP;
+    }
+
+    LOG_ERR("Unhandled endpoint transport %d", current_instance.transport);
+    return -ENOTSUP;
+}
+#endif // IS_ENABLED(CONFIG_ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_HID)
+
 #if IS_ENABLED(CONFIG_ZMK_POINTING)
 int zmk_endpoint_send_mouse_report() {
     switch (current_instance.transport) {
@@ -471,12 +535,14 @@ static int zmk_endpoints_init(void) {
 void zmk_endpoint_clear_reports(void) {
     zmk_hid_keyboard_clear();
     zmk_hid_consumer_clear();
+    zmk_hid_vkey_clear();
 #if IS_ENABLED(CONFIG_ZMK_POINTING)
     zmk_hid_mouse_clear();
 #endif // IS_ENABLED(CONFIG_ZMK_POINTING)
 
     zmk_endpoint_send_report(HID_USAGE_KEY);
     zmk_endpoint_send_report(HID_USAGE_CONSUMER);
+    zmk_endpoint_send_vkey_report();
 }
 
 static void update_current_endpoint(void) {
