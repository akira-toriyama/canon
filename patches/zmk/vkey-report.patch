+
+#if IS_ENABLED(CONFIG_ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_HID)
+// Deliberately does NOT go through zmk_usb_hid_send_report(): a battery level
+// is state, not an edge, and must be dropped rather than queued when the bus
+// cannot take it now. That path would otherwise
+//   - enqueue it in the 8 deep pending ring, which evicts the OLDEST entry, so
+//     a level nobody is waiting for can push out a queued keystroke, and
+//   - call usb_wakeup_request() in the USB_DC_SUSPEND arm, waking a sleeping
+//     host because a half's charge changed or a half dropped off.
+// zmk_usb_is_hid_ready() cannot gate that from the caller: USB_DC_SUSPEND maps
+// to ZMK_USB_CONN_HID and is_configured stays true, so it reads ready through
+// the whole suspend.
+int zmk_usb_hid_send_split_battery_report(void) {
+#if IS_ENABLED(CONFIG_ZMK_USB_BOOT)
+    if (hid_protocol == HID_PROTOCOL_BOOT) {
+        return -ENOTSUP;
+    }
+#endif /* IS_ENABLED(CONFIG_ZMK_USB_BOOT) */
+
+    switch (zmk_usb_get_status()) {
+    case USB_DC_SUSPEND:
+    case USB_DC_ERROR:
+    case USB_DC_RESET:
+    case USB_DC_DISCONNECTED:
+    case USB_DC_UNKNOWN:
+    case USB_DC_CONNECTED:
+        return -EAGAIN;
+    default:
+        break;
+    }
+
+    // Reports are still queued from a not-ready window. Appending would put a
+    // battery level in the ring; overtaking them would reorder keystrokes.
+    if (pending_head != pending_tail) {
+        return -EAGAIN;
+    }
+
+    struct zmk_hid_split_battery_report *report = zmk_hid_get_split_battery_report();
+
+    k_sem_take(&hid_sem, K_MSEC(30));
+    int err = hid_int_ep_write(hid_dev, (uint8_t *)report, sizeof(*report), NULL);
+
+    if (err) {
+        k_sem_give(&hid_sem);
+    }
+
+    return err;
+}
+#endif // IS_ENABLED(CONFIG_ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_HID)
+
