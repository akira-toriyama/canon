{
  // Format on save
  "editor.formatOnSave": true,

  // Language associations for syntax highlighting:
  // - .keymap/.dtsi/.overlay: DeviceTree (the plorefice.devicetree extension,
  //   recommended in .vscode/extensions.json; plain text without it)
  // - .conf: a built-in language as an approximation
  "files.associations": {
    "**/*.keymap": "devicetree",
    "**/*.dtsi": "devicetree",
    "**/*.overlay": "devicetree",
    "**/*.conf": "properties"
  },

  // prettier is the default formatter only for the languages it handles;
  // .dtsi / .keymap / .conf / .sh / .py and the like are left to other tools.
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  }
}
