// behaviors { } ブロックの中身。imprint.keymap から #include して使う。
// マクロ (HOLD_TAP_HP200) は keymap_defines.h で定義。

    // ==== IME hold-tap (combos.dtsi の ime_kana / ime_eiji 経由で発火) ====
    HOLD_TAP_HP200(ime_kana, &kana)
    HOLD_TAP_HP200(ime_eiji, &eiji)

    // ==== IME tap-dance (tap = かな / double-tap = 英数) ====
    // 単発 tap の確定は tapping-term 満了か他キー割込みまで遅延する
    // (tap-dance の仕様。連続タイピング時は次キー押下で即確定)。
    ime_dance: ime_dance {
      compatible = "zmk,behavior-tap-dance";
      #binding-cells = <0>;
      tapping-term-ms = <200>;
      bindings = <&kana>, <&eiji>;
    };

    // ==== letter / arrow mod-morph ====
    #include "letter_morphs.dtsi"
    #include "arrow_behaviors.dtsi"

    // ==== vendor-defined "original key" (vkey) ====
    // &vkey behavior ノード（config/vkey_behavior.dtsi が唯一のソース）。
    #include "vkey_behavior.dtsi"

