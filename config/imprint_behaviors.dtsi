// The keymap's behaviors, included in its behaviors { } node. The generator
// macros are in behavior_macros.h.

    // The IME hold-taps of combo_kana / combo_eiji (combos.dtsi).
    HOLD_TAP_HP200(ime_kana, &kana)
    HOLD_TAP_HP200(ime_eiji, &eiji)

    #include "letter_morphs.dtsi"
    #include "arrow_behaviors.dtsi"

    // &vkey <id>: vendor HID report 0x20 (press = id, release = 0) that the
    // host bridge chord maps to an action. The behavior comes from
    // patches/zmk/vkey-report.patch (central builds only, USB only);
    // scripts/gen-vkey-aliases.py reads the ids from imprint.keymap.
    vkey: vkey {
        compatible = "zmk,behavior-vkey";
        #binding-cells = <1>;
    };
