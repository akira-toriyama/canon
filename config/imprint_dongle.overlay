// Dongle 用 user overlay。shield 本体は upstream (Cyboard zmk-keyboards
// zephyr-4.1) の boards/shields/imprint_dongle/。
//
// upstream dongle shield は standalone（imprint.dtsi を include しない）で、
// 既定 transform は function-row variant (imprint_function_row_full_bottom_row)。
// canon の keymap (config/imprint.keymap が shield 名 fallback で dongle build
// にも使われる) は chosen で letters-only transform を参照するため、その
// ノード定義をここで補う。map は upstream imprint.dtsi の
// imprint_letters_only_full_bottom_row (keymap_transform_8) と同一。

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    imprint_letters_only_full_bottom_row: keymap_transform_8 {
        compatible = "zmk,matrix-transform";
        columns = <8>;
        rows = <14>;
        map = <
RC(4,5) RC(4,4) RC(4,3) RC(4,2) RC(4,1) RC(4,0)                           RC(11,0) RC(11,1) RC(11,2) RC(11,3) RC(11,4) RC(11,5)
RC(3,5) RC(3,4) RC(3,3) RC(3,2) RC(3,1) RC(3,0)                           RC(10,0) RC(10,1) RC(10,2) RC(10,3) RC(10,4) RC(10,5)
RC(2,5) RC(2,4) RC(2,3) RC(2,2) RC(2,1) RC(2,0)                           RC(9,0)  RC(9,1)  RC(9,2)  RC(9,3)  RC(9,4)  RC(9,5)
RC(1,5) RC(1,4) RC(1,3) RC(1,2) RC(1,1)                                            RC(8,1)  RC(8,2)  RC(8,3)  RC(8,4)  RC(8,5)
                                    RC(0,3) RC(0,2) RC(0,1)   RC(7,1) RC(7,2) RC(7,3)
                                    RC(0,7) RC(0,6) RC(0,5)   RC(7,5) RC(7,6) RC(7,7)
        >;
    };
};

// The dongle has no battery, but the xiao_ble board wires zmk,battery to its
// voltage divider, and an unloaded divider reads a bogus level (100% on USB
// power in the advertisement decoded 2026-09-26; 47% seen earlier). The
// Prospector module (CENTRAL_SIDE="AUX") copies the central's own reading into
// the Aux1 slot of the status advertisement. Until 2026-09-26 the Prospector
// Dongle ran t-ogura's prospector_scanner, whose YADS and Operator layouts drew
// every slot > 0, so the ghost showed as a third battery; its zmk-beacon
// screen reads the halves' bytes only.
// Without a chosen node ZMK's battery.c bails out with -ENODEV and keeps
// reporting 0, which every consumer treats as "absent". Nothing reads the
// dongle's own level: chord's vendor report 0x21 carries the halves only,
// and USB HID has no battery path. Disabling vbatt also drops the divider's
// ADC channel and its power GPIO from the build.
/ {
    chosen {
        /delete-property/ zmk,battery;
    };
};

&vbatt {
    status = "disabled";
};
