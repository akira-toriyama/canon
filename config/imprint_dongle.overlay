// The upstream imprint_dongle shield (zmk-keyboards, zephyr-4.1) is standalone:
// it does not include imprint.dtsi, and its default transform is the
// function-row one. config/imprint.keymap, which this build also uses (the
// "imprint" prefix of the shield name), chooses the letters-only transform, so
// its node is defined here as a copy of imprint_letters_only_full_bottom_row
// (keymap_transform_8) in upstream imprint.dtsi.

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    imprint_letters_only_full_bottom_row: keymap_transform_8 {
        compatible = "zmk,matrix-transform";
        columns = <8>;
        rows = <14>;
        map = <
RC(4,5) RC(4,4) RC(4,3) RC(4,2) RC(4,1) RC(4,0)                           RC(11,0) RC(11,1) RC(11,2) RC(11,3) RC(11,4) RC(11,5)
RC(3,5) RC(3,4) RC(3,3) RC(3,2) RC(3,1) RC(3,0)                           RC(10,0) RC(10,1) RC(10,2) RC(10,3) RC(10,4) RC(10,5)
RC(2,5) RC(2,4) RC(2,3) RC(2,2) RC(2,1) RC(2,0)                           RC(9,0)  RC(9,1)  RC(9,2)  RC(9,3)  RC(9,4)  RC(9,5)
RC(1,5) RC(1,4) RC(1,3) RC(1,2) RC(1,1)                                            RC(8,1)  RC(8,2)  RC(8,3)  RC(8,4)  RC(8,5)
                                    RC(0,3) RC(0,2) RC(0,1)   RC(7,1) RC(7,2) RC(7,3)
                                    RC(0,7) RC(0,6) RC(0,5)   RC(7,5) RC(7,6) RC(7,7)
        >;
    };
};

// The dongle has no battery, but ZMK's xiao_ble board points zmk,battery at
// its voltage divider, which reads a meaningless level with no cell attached.
// Nothing reads the dongle's own level: chord's vendor report 0x21 and
// zmk-beacon's status advertisement carry the halves' levels only (peripheral
// battery events), and USB HID has no battery path. Without the chosen node
// ZMK's battery.c finds no battery device and never samples; disabling vbatt
// also drops the divider's ADC channel and power GPIO from the build.
/ {
    chosen {
        /delete-property/ zmk,battery;
    };
};

&vbatt {
    status = "disabled";
};
