// Letter keys al_a .. al_z (LETTER_MORPH, behavior_macros.h), included in the
// keymap's behaviors { } node: the letter alone, and with Shift EIJI first
// (eiji_macro), so that Shift+letter types a Latin capital in any input mode.
// Nothing is generated from this list.

    LETTER_MORPH(al_a, A)
    LETTER_MORPH(al_b, B)
    LETTER_MORPH(al_c, C)
    LETTER_MORPH(al_d, D)
    LETTER_MORPH(al_e, E)
    LETTER_MORPH(al_f, F)
    LETTER_MORPH(al_g, G)
    LETTER_MORPH(al_h, H)
    LETTER_MORPH(al_i, I)
    LETTER_MORPH(al_j, J)
    LETTER_MORPH(al_k, K)
    LETTER_MORPH(al_l, L)
    LETTER_MORPH(al_m, M)
    LETTER_MORPH(al_n, N)
    LETTER_MORPH(al_o, O)
    LETTER_MORPH(al_p, P)
    LETTER_MORPH(al_q, Q)
    LETTER_MORPH(al_r, R)
    LETTER_MORPH(al_s, S)
    LETTER_MORPH(al_t, T)
    LETTER_MORPH(al_u, U)
    LETTER_MORPH(al_v, V)
    LETTER_MORPH(al_w, W)
    LETTER_MORPH(al_x, X)
    LETTER_MORPH(al_y, Y)
    LETTER_MORPH(al_z, Z)
