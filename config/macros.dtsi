// macros { } ブロック内に #include して使う
// 数字 / 記号の eiji 系マクロ (en_*) は eiji_macros.dtsi をさらに #include

    // ==== IME 切替 ====

    // EIJI 切替 → 渡された base key を press/release。letter morph (al_*) の
    // Shift 時に呼ばれ、英語入力モードに移してから大文字を出力する。
    eiji_macro: eiji_macro {
      compatible = "zmk,behavior-macro-one-param";
      #binding-cells = <1>;
      bindings = <&macro_tap &kp EIJI>, <&macro_param_1to1>, <&macro_press &kp MACRO_PLACEHOLDER>, <&macro_pause_for_release>, <&macro_param_1to1>, <&macro_release &kp MACRO_PLACEHOLDER>;
    };
    // かな入力へ切替 (combo_kana の ime_kana tap binding)
    kana: kana {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      bindings = <&kp KANA>;
    };
    // 英数入力へ切替 (combo_eiji の ime_eiji tap binding / eiji_macro と併用)
    eiji: eiji {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      bindings = <&kp EIJI>;
    };

    // ==== 親指上段 (TU): layer 起動。LL/LM は修飾子も同時 hold ====
    //
    // TU_LL/TU_LM は layer 起動と同時に LCtrl/LAlt を hold する実体 (t_ll_ctrl /
    // t_lm_alt)。TU_RM/TU_RR は層起動のみ (behavior_macros.h で &mo)。各
    // T_*_LAYER のキーは &vkey id を送出する (vendor-HID。旧・修飾子 chord 方式は廃止)。
    TU_MOD(t_ll_ctrl, T_LL_LAYER, LCTRL)
    TU_MOD(t_lm_alt,  T_LM_LAYER, LALT)

    // ==== EIJI 切替 → 数字 / 記号キー専用 behavior 群 ====
    // 機能的には上の eiji_macro と同一（EIJI tap → key press/release）だが、
    // keymap-drawer が個別の名前付き behavior に raw_binding_map で表示文字を
    // 紐付けるため、en_0 / en_under など 0-cell の独立 behavior として展開
    // する必要があり、`EN_MACRO` という別マクロで実装している。統一すると
    // 描画名空間が失われるので分離は意図的。
    #include "eiji_macros.dtsi"
