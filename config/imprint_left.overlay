#include "ext_power_off.dtsi"

// The left trackball goes to the Imprint Dongle: the left half is a split
// peripheral, and upstream imprint.dtsi carries the sending input-split node
// trackball_central_split@1, disabled by default. trackball_central is the
// left PMW3610, named for the left half's central role without a dongle. The
// upstream imprint_dongle shield defines the receiving proxy (same reg 1, no
// device) and its listener.
&trackball_central_split {
    status = "okay";
    device = <&trackball_central>;
};

// The right half's node is enabled in imprint.dtsi without a device, and a
// peripheral build needs a device on every enabled input-split node
// (BUILD_ASSERT in ZMK's input_split.c), so the left build disables it.
&trackball_peripheral_split {
    status = "disabled";
};
