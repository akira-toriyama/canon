// The keymap's combos, included in its combos { } node. The two lower thumb
// keys of a hand together: tap = input source (left kana, right English),
// hold = a modifier pair, through the ime_kana / ime_eiji hold-taps.

    combo_kana {
      key-positions = <KEY_POSITION_LL KEY_POSITION_LM>;
      bindings = <&ime_kana LS(LEFT_COMMAND) KANA>;
    };
    combo_eiji {
      key-positions = <KEY_POSITION_RM KEY_POSITION_RR>;
      bindings = <&ime_eiji LC(LALT) EIJI>;
    };
