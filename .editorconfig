root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,json,toml}]
indent_style = space
indent_size = 2

[*.{sh,bash}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

# Markdown: two trailing spaces are a line break, so they stay
[*.md]
trim_trailing_whitespace = false

# Devicetree, ZMK keymap, conf and C header files keep their existing layout
[*.{keymap,dtsi,overlay,conf,h}]
trim_trailing_whitespace = false
