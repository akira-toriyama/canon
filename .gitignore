# Claude Code's local settings and worktrees (never committed, as in the other repos)
.claude/

# Images from local builds (scripts/build-zmk.sh)
/firmware/

__pycache__/
*.pyc

# Personal files for local builds (assets/README.md). The GIF pattern also
# catches a sprite copied anywhere else, in any letter case: core.ignorecase
# is false on a case-sensitive volume, where `*.gif` would miss `.GIF`.
/assets/*
!/assets/README.md
!/assets/sprite-name.sh
*.[gG][iI][fF]
