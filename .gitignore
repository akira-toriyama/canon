# Claude Code's local settings and worktrees (never committed, as in the other repos)
.claude/

# Images from local builds (scripts/build-zmk.sh)
/firmware/

__pycache__/
*.pyc

# Personal files for local builds live off the repository (assets/README.md);
# these rules guard against one copied in by mistake. The GIF pattern catches
# a sprite anywhere, in any letter case: core.ignorecase is false on a
# case-sensitive volume, where `*.gif` would miss `.GIF`.
/assets/*
!/assets/README.md
!/assets/sprite-name.sh
*.[gG][iI][fF]
